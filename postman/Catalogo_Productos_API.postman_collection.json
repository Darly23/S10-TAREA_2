      "item": [
        {
          "name": "01. Registro de Usuario A (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Respuesta exitosa y rol usuario asignado', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.rol).to.eql('usuario');",
                  "    pm.expect(json.data).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Demo A\",\n  \"correo\": \"usuarioA@catalogo.com\",\n  \"password\": \"UserA1234!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            }
