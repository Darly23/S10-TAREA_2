    {
      "name": "02. Catálogo de Productos (Público)",
      "description": "Consultas públicas sin token, filtros por categoría y validaciones de IDs.",
      "item": [
        {
          "name": "01. Listar Productos Públicamente (200 OK - Guarda producto_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve al menos 5 productos y guarda un ID para pruebas', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.length).to.be.at.least(5);",
                  "    pm.environment.set('producto_id', json.data[0]._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "02. Filtrar Productos por Categoría (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Todos los productos corresponden a la categoría filtrada', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    json.data.forEach(function (prod) {",
                  "        pm.expect(prod.categoria.toLowerCase()).to.eql('monitores');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos?categoria=monitores",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "monitores"
                }
              ]
            }
          }
        },
        {
          "name": "03. Consultar Producto por ID (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('El producto consultado coincide con el ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data._id).to.eql(pm.environment.get('producto_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos",
                "{{producto_id}}"
              ]
            }
          }
        },
