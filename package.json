{
  "name": "s10-tarea-2-catalogo-productos",
  "version": "1.0.0",
  "description": "API REST con Node.js, Express y MongoDB para catálogo de productos, favoritos personales y control de acceso basado en roles (RBAC) con JWT.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
