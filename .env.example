# Puerto del servidor
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos (MongoDB local o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/catalogo_db

# Configuración de JWT
JWT_SECRET=tu_clave_secreta_super_segura_aqui
JWT_EXPIRES_IN=24h

# Credenciales para el script de inicialización (Seed) del Administrador
ADMIN_NAME=Administrador Inicial
ADMIN_EMAIL=admin@catalogo.com
ADMIN_PASSWORD=Admin1234!
